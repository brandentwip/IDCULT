      "advanced_content_XGabYc": {
        "type": "advanced-content",
        "blocks": {
          "html_TiGRfg": {
            "type": "html",
            "settings": {
              "code": "<!-- GIFT CARD IMAGE POPUP START -->\n<style>\n  .gift-popup-overlay {\n    position: fixed;\n    inset: 0;\n    background: radial-gradient(circle at center, rgba(139,0,0,0.25), rgba(0,0,0,0.7));\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    z-index: 9999;\n\n    opacity: 0;\n    visibility: hidden;\n    transition: opacity 0.4s ease, visibility 0.4s ease;\n  }\n\n  .gift-popup-overlay.active {\n    opacity: 1;\n    visibility: visible;\n  }\n\n  .gift-popup {\n    position: relative;\n    max-width: 420px;\n    width: 90%;\n\n    transform: scale(0.94);\n    opacity: 0;\n    transition: transform 0.45s ease, opacity 0.45s ease;\n\n    /* Soft romantic glow */\n    box-shadow:\n      0 20px 40px rgba(139, 0, 0, 0.25),\n      0 0 0 1px rgba(255, 255, 255, 0.4);\n    border-radius: 14px;\n  }\n\n  .gift-popup-overlay.active .gift-popup {\n    transform: scale(1);\n    opacity: 1;\n    animation: heartbeat 1.2s ease 0.45s;\n  }\n\n  .gift-popup img {\n    width: 100%;\n    height: auto;\n    border-radius: 14px;\n    display: block;\n  }\n\n  .gift-popup-close {\n    position: absolute;\n    top: -14px;\n    right: -14px;\n    background: linear-gradient(145deg, #8B0000, #B11226);\n    color: #fff;\n    border: none;\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    font-size: 20px;\n    cursor: pointer;\n    line-height: 1;\n    box-shadow: 0 6px 14px rgba(139,0,0,0.4);\n  }\n\n  .gift-popup-close:hover {\n    transform: scale(1.05);\n  }\n\n  @keyframes heartbeat {\n    0% { transform: scale(1); }\n    30% { transform: scale(1.03); }\n    55% { transform: scale(0.99); }\n    75% { transform: scale(1.02); }\n    100% { transform: scale(1); }\n  }\n\n  @media (max-width: 480px) {\n    .gift-popup {\n      max-width: 90%;\n    }\n  }\n</style>\n\n<div class=\"gift-popup-overlay\" id=\"giftPopup\">\n  <div class=\"gift-popup\">\n    <button class=\"gift-popup-close\" id=\"giftPopupClose\">×</button>\n\n    <a href=\"https://idcult.com/products/valentines-gift-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0636/5128/3192/files/Artboard_1_jpg.jpg?v=1770706217\" alt=\"Valentine Gift Card Offer\">\n    </a>\n  </div>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const popup = document.getElementById(\"giftPopup\");\n    const closeBtn = document.getElementById(\"giftPopupClose\");\n\n    setTimeout(() => {\n      popup.classList.add(\"active\");\n    }, 1000);\n\n    closeBtn.addEventListener(\"click\", () => {\n      popup.classList.remove(\"active\");\n    });\n  });\n</script>\n<!-- GIFT CARD IMAGE POPUP END -->",
              "width": "100%",
              "alignment": "center"
            }
          }
        },
